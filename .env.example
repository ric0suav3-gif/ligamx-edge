# Copy this file to .env and add your API-Football key locally.
# Never commit the real key.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Historical backfills can hit API-Football's per-minute rate limit.
# 0.40 seconds keeps requests deliberately paced; raise this if needed.
API_FOOTBALL_MIN_INTERVAL=0.40
API_FOOTBALL_MAX_RETRIES=6
